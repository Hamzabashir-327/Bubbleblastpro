; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.

config_version=5

[application]

config/name="Bubble Blast Pro"
config/description="Bubble Blast Pro - Mystic Worlds. An original offline bubble shooter."
run/main_scene="res://scenes/main/splash.tscn"
config/features=PackedStringArray("4.5", "GL Compatibility")
config/icon="res://assets/icons/icon.png"
config/quit_on_go_back=false

[autoload]

SaveManager="*res://scripts/core/save_manager.gd"
GameManager="*res://scripts/core/game_manager.gd"
LevelManager="*res://scripts/core/level_manager.gd"
AudioManager="*res://scripts/core/audio_manager.gd"
CoinManager="*res://scripts/economy/coin_manager.gd"
RewardManager="*res://scripts/economy/reward_manager.gd"
AdManager="*res://scripts/ads/ad_manager.gd"

[display]

window/size/viewport_width=720
window/size/viewport_height=1280
window/size/window_width_override=450
window/size/window_height_override=800
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=1

[input_devices]

pointing/emulate_touch_from_mouse=true

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/vram_compression/import_etc2_astc=true
